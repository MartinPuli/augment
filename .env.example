# GHOST coordinator — copy to .env.local and fill in what you need.
# Everything is optional: with no variables set, the coordinator runs on embedded PGlite (.ghost/pgdata).

# HTTP port (Next.js + coordinator share one server). Listens on 0.0.0.0.
PORT=3000

# Postgres (e.g. Neon). If unset, embedded PGlite is used (zero setup).
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional Postgres schema (default "public"). Uses the direct (non-pooler) endpoint when set.
# GHOST_DB_SCHEMA=public
# PGlite data directory when DATABASE_URL is unset.
# GHOST_PGDATA=.ghost/pgdata

# Public origin used for join links / QR codes (e.g. an ngrok/cloudflared tunnel for phones).
# NEXT_PUBLIC_PUBLIC_ORIGIN=https://ghost-demo.example.com
# Fallback origin for connector upload URLs (normally derived from the connector's own request).
# GHOST_PUBLIC_ORIGIN=https://ghost-demo.example.com

# Set to 1 to skip internal adapter discovery at boot (Caltrans, NOAA, LAN, ...).
# GHOST_SKIP_ADAPTERS=1
# Set to 1 to silence coordinator info logs.
# GHOST_QUIET=1

# No AI model or voice-provider keys are needed. Personal agents supply their own reasoning.

# Coordinator LAN scans are disabled in production by default. Run an outbound gateway on
# the owner network instead. Only for a private coordinator physically on its owner LAN:
# GHOST_LOCAL_LAN_OWNER_ID=usr_...
# Gateway-only Home Assistant credentials (never needed on the hosted coordinator):
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=your-local-long-lived-token

# Gateway-only printer configuration. API keys are resolved from environment variable
# names inside this JSON file; see connectors/lan/printers.example.json.
# GHOST_PRINTERS_CONFIG=/absolute/path/to/.ghost/printers.json

# Experimental Personal Agent Protocol (Poppy draft 0.1, guest-only).
# Disabled by default. Canonical HTTPS origin; never inferred from request headers.
# GHOST_POPPY_ENABLED=1
# GHOST_POPPY_ORIGIN=https://your-ghost-domain.example
# Comma-separated exact HTTPS client metadata URLs, registered by the operator.
# GHOST_POPPY_CLIENTS=https://your-agent.example/client.json
# See docs/poppy.md: no account sign-in, rental operations or payments are advertised.

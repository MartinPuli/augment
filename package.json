{
  "name": "ghost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \".next/**\" --exclude \".ghost/**\" --exclude \"src/app/**\" --exclude \"src/components/**\" server.ts",
    "build": "tsx scripts/fetch-illustrations.ts --soft && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "coord:smoke": "tsx scripts/coord-smoke.ts",
    "devices:memory-test": "tsx scripts/device-memory-test.ts",
    "coord:fake-connector": "tsx scripts/coord-fake-connector.ts",
    "mastra:dev": "GHOST_DATA_DIR=${GHOST_DATA_DIR:-$PWD/.ghost} GHOST_COORDINATOR_URL=${GHOST_COORDINATOR_URL:-http://127.0.0.1:3000} mastra dev --dir src/mastra",
    "infra:mission-test": "tsx scripts/infra-mission-test.ts",
    "infra:neon-check": "tsx scripts/infra-neon-check.ts",
    "hardware:gateway": "tsx connectors/lan/ghost-lan.ts",
    "hardware:test": "tsx scripts/hardware-gateway-test.ts",
    "hardware:printer-test": "tsx scripts/printer-gateway-test.ts",
    "poppy:test": "tsx scripts/poppy-test.ts",
    "distributed:test": "tsx scripts/distributed-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@assistant-ui/react": "^0.15.23",
    "@electric-sql/pglite": "^0.5.8",
    "@elevenlabs/client": "^1.26.0",
    "@elevenlabs/react": "^1.16.0",
    "@hono/node-server": "^2.1.3",
    "@interfere/next": "^11.2.1",
    "@mastra/core": "^1.74.0",
    "@mastra/libsql": "^1.25.0",
    "@mastra/observability": "^1.18.3",
    "@mastra/pg": "^1.29.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@onkernel/sdk": "^0.119.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/functions": "^3.9.11",
    "agentmail": "^0.5.35",
    "bonjour-service": "^1.4.4",
    "clsx": "^2.1.1",
    "exa-js": "^2.25.0",
    "hls.js": "^1.7.3",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "lucide": "1.51.0",
    "lucide-react": "1.51.0",
    "morphicons": "^1.7.1",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "node-ical": "^0.27.3",
    "onnxruntime-web": "^1.30.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "mastra": "^1.32.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.7.1"
